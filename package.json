{
  "name": "@v0idd0/ctxstuff",
  "version": "3.0.5",
  "description": "Pack a code directory into one context file for LLM prompts. Count tokens, compare models, split or optimize to a token limit, and estimate cost from a price table dated 2026-11-26.",
  "main": "index.js",
  "bin": {
    "ctxstuff": "bin/ctxstuff.js"
  },
  "scripts": {
    "test": "node test.js",
    "start": "node bin/ctxstuff.js"
  },
  "keywords": [
    "llm",
    "llm-context",
    "context-packing",
    "codebase-packer",
    "repo-to-llm",
    "tokens",
    "token-counting",
    "cost-estimator",
    "cli",
    "developer-tools",
    "openai",
    "anthropic"
  ],
  "author": "vøiddo <support@voiddo.com> (https://voiddo.com)",
  "license": "MIT",
  "homepage": "https://voiddo.com/packages/#ctxstuff",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidd0/ctxstuff.git"
  },
  "bugs": {
    "url": "https://github.com/voidd0/ctxstuff/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0"
  },
  "optionalDependencies": {
    "tiktoken": "^1.0.12",
    "chokidar": "^3.5.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "src/",
    "index.js",
    "README.md",
    "LICENSE"
